<Window x:Class="ShroudStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShroudStudio" Width="1280" Height="780" MinWidth="1050" MinHeight="650"
        WindowState="Maximized" Background="#071214" Foreground="#E8F1EF" WindowStartupLocation="CenterScreen"
        Loaded="WindowLoaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#A80B1B1E"/>
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#B815292D"/>
        <SolidColorBrush x:Key="LineBrush" Color="#7A2D6F72"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#91A7A7"/>
        <SolidColorBrush x:Key="TealBrush" Color="#73D2C0"/>
        <SolidColorBrush x:Key="TealDarkBrush" Color="#315E5B"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#DDF8F1"/>
            <Setter Property="Background" Value="#112326"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1C6C6B"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#DDF8F1"/>
            <Setter Property="Background" Value="#152B2E"/>
            <Setter Property="BorderBrush" Value="#3F9F9A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                <Grid>
                                    <ContentPresenter Margin="10,0,30,0" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                    <ToggleButton HorizontalAlignment="Right" Width="28" Background="Transparent"
                                                  BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                        <TextBlock Text="⌄" Foreground="{TemplateBinding Foreground}" FontSize="15"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup Name="Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="#0D1B1E" BorderBrush="#45C9BD" BorderThickness="1"
                                        CornerRadius="5" Padding="3">
                                    <ScrollViewer MaxHeight="260" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#233B3D"/>
                    <Setter Property="Foreground" Value="#E8F1EF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#0C1A1B"/>
            <Setter Property="Background" Value="{StaticResource TealBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TealBrush}"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A4F0DF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="#D6E6E2"/>
            <Setter Property="Background" Value="#243A3D"/>
            <Setter Property="BorderBrush" Value="#3B5B5A"/>
        </Style>
        <Style x:Key="DarkToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#DDF8F1"/>
            <Setter Property="Background" Value="#243A3D"/>
            <Setter Property="BorderBrush" Value="#3B5B5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#1C6C6B"/>
                    <Setter Property="BorderBrush" Value="#73D2C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InventoryTileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.82"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E8F1EF"/>
            <Setter Property="Background" Value="#112326"/>
            <Setter Property="BorderBrush" Value="#3F9F9A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CaretBrush" Value="#73D2C0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="5" Direction="270"
                                      Color="#00EBD7" Opacity="0.16"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F0F7F4"/>
        </Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Storyboard x:Key="GlowAnimation">
            <DoubleAnimation Storyboard.TargetName="StatusGlow" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.8" Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
        <Storyboard x:Key="AmbientAnimation">
            <DoubleAnimation Storyboard.TargetName="OrbTransformA" Storyboard.TargetProperty="X"
                             From="-80" To="260" Duration="0:1:18" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="OrbTransformA" Storyboard.TargetProperty="Y"
                             From="30" To="-90" Duration="0:0:54" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="OrbTransformB" Storyboard.TargetProperty="X"
                             From="120" To="-260" Duration="0:1:32" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="OrbTransformB" Storyboard.TargetProperty="Y"
                             From="-40" To="110" Duration="0:1:06" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="OrbTransformC" Storyboard.TargetProperty="X"
                             From="-100" To="220" Duration="0:1:45" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="OrbTransformC" Storyboard.TargetProperty="Y"
                             From="80" To="-70" Duration="0:1:16" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="66"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="620" Height="620" Opacity="0.52" Canvas.Left="-150" Canvas.Top="80">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#98D6FFF0" Offset="0"/>
                        <GradientStop Color="#4379D9C9" Offset="0.42"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="24"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="OrbTransformA"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="760" Height="760" Opacity="0.42" Canvas.Left="720" Canvas.Top="-280">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#75CFFFEF" Offset="0"/>
                        <GradientStop Color="#326BCBC0" Offset="0.46"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="32"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="OrbTransformB"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="560" Height="560" Opacity="0.36" Canvas.Left="370" Canvas.Top="490">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#68BDF3DE" Offset="0"/>
                        <GradientStop Color="#2E5FADA2" Offset="0.44"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="28"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="OrbTransformC"/></Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>
        <Border Grid.Row="0" Background="#102023" BorderBrush="#284043" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="142" Height="42" Stretch="Uniform" Source="/ShroudStudio.App;component/Assets/logo.png"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Name="StatusGlow" Width="8" Height="8" Margin="22,0,7,0"
                             Fill="{StaticResource TealBrush}" Opacity="0.6"/>
                    <TextBlock Name="HeaderStatusTextBlock" Text="Bereit" Foreground="{StaticResource TealBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource NavButtonStyle}" Padding="12,8"
                        Content="⚙  Einstellungen" Click="SettingsNavigationClick"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0F2022" BorderBrush="#284043" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,22">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Border Background="#182D2F" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Sicherer Arbeitsbereich" Foreground="#DCEBE7" FontWeight="SemiBold"/>
                                <TextBlock Name="SidebarSafetyTextBlock" Margin="0,5,0,0"
                                           Text="Dein Original bleibt geschützt." Style="{StaticResource CaptionStyle}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel>
                        <Button Name="OverviewButton" Style="{StaticResource NavButtonStyle}" Content="▦   Übersicht"
                                Click="OverviewNavigationClick"/>
                        <Button Name="ItemsButton" Style="{StaticResource NavButtonStyle}" Content="◇   Items"
                                Click="ItemsNavigationClick"/>
                        <Button Name="InventoryButton" Style="{StaticResource NavButtonStyle}" Content="▤   Inventar &amp; Kisten"
                                Click="InventoryNavigationClick"/>
                        <Button Name="WeaponsButton" Style="{StaticResource NavButtonStyle}" Content="⚔   Waffen &amp; Ausrüstung"
                                Click="WeaponsNavigationClick"/>
                        <Button Name="DebugButton" Style="{StaticResource NavButtonStyle}" Content="◌   Diagnose"
                                Click="DebugNavigationClick"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="30,28,34,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Name="PageTitleTextBlock" Style="{StaticResource SectionTitleStyle}" Text="Übersicht"/>
                        <TextBlock Name="PageSubtitleTextBlock" Margin="0,5,0,22" Style="{StaticResource CaptionStyle}"
                                   Text="Verwalte deine Spielstände und bereite deine nächsten Abenteuer vor."/>
                    </StackPanel>

                    <Grid Grid.Row="1" Name="OverviewPage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource TealBrush}" Margin="0,5,9,0"/>
                                    <TextBlock Text="Aktueller Spielstand" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,26,0,20">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                                        <StackPanel>
                                            <TextBlock Text="Welt / Server" Foreground="{StaticResource MutedBrush}"/>
                                            <ComboBox Name="SlotComboBox" Width="220" Height="34" Margin="0,6,14,0"
                                                      Style="{StaticResource DarkComboBoxStyle}" ToolTip="Erkannte Welt-Savegames"
                                                      SelectionChanged="SlotSelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Autosave" Foreground="{StaticResource MutedBrush}"/>
                                            <ComboBox Name="AutosaveComboBox" Width="170" Height="34" Margin="0,6,14,0"
                                                      Style="{StaticResource DarkComboBoxStyle}" ToolTip="Version der gewählten Welt"
                                                      SelectionChanged="AutosaveSelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Charakter" Foreground="{StaticResource MutedBrush}"/>
                                            <ComboBox Name="CharacterComboBox" Width="220" Height="34" Margin="0,6,0,0"
                                                      Style="{StaticResource DarkComboBoxStyle}" ToolTip="Separates Charakter-Savegame"
                                                      SelectionChanged="CharacterSelectionChanged"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Name="OverviewSavegameNameTextBlock" Text="Spielstand wird geladen"
                                               FontSize="30" FontWeight="SemiBold"/>
                                    <TextBlock Name="OverviewSavegameInfoTextBlock" Margin="0,8,0,0"
                                               Text="Bereit für deine nächste Änderung."
                                               Style="{StaticResource CaptionStyle}"/>
                                    <TextBlock Name="OverviewCharacterInfoTextBlock" Margin="0,6,0,0"
                                               Text="Kein Charakter-Savegame ausgewählt."
                                               Style="{StaticResource CaptionStyle}"/>
                                    <TextBlock Name="OverviewSavegamePathTextBlock" Margin="0,20,0,0"
                                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Sicherung erstellen" Click="CreateBackupClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Sicherheitsstatus" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Name="SafetyStatusTextBlock" Margin="0,18,0,0"
                                           Text="Original geschützt" Foreground="{StaticResource TealBrush}" FontSize="20"/>
                                <TextBlock Margin="0,8,0,0" Text="Änderungen werden erst nach Prüfung als neue Datei erstellt."
                                           Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Schnellzugriff" FontSize="16" FontWeight="SemiBold"/>
                                <UniformGrid Margin="0,16,0,0" Columns="3">
                                    <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Items durchsuchen" Click="ItemsNavigationClick"/>
                                    <Button Margin="4,0,4,0" Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Inventar ansehen" Click="InventoryNavigationClick"/>
                                    <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Spieldaten prüfen" Click="ReanalyzeGameDataClick"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Name="ContentPage" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Name="ContentPageHeadline" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Name="ContentPageMessage" Margin="0,12,0,0" Style="{StaticResource CaptionStyle}"
                                           TextWrapping="Wrap" HorizontalAlignment="Left"/>
                                <Border Name="ContentPageDataPanel" Margin="0,22,0,0"
                                        Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock Name="ContentPageDataTitle1" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Name="ContentPageDataValue1" Margin="0,8,0,0"
                                                       Foreground="{StaticResource TealBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="18,0,18,0">
                                            <TextBlock Name="ContentPageDataTitle2" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Name="ContentPageDataValue2" Margin="0,8,0,0"
                                                       Foreground="{StaticResource TealBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="18,0,0,0">
                                            <TextBlock Name="ContentPageDataTitle3" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Name="ContentPageDataValue3" Margin="0,8,0,0"
                                                       Foreground="{StaticResource TealBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Name="ContentPageFacts" Margin="0,18,0,0"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                <Border Name="LiveDataPanel" Margin="0,18,0,0" Padding="16"
                                        Background="#101F22" BorderBrush="#315E5B" BorderThickness="1"
                                        CornerRadius="8" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="21" Background="#1B4A47"
                                                VerticalAlignment="Top">
                                            <TextBlock Name="LiveDataGlyph" Text="◆" FontSize="18"
                                                       Foreground="{StaticResource TealBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                            <TextBlock Name="LiveDataTitle" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="#DDF8F1"/>
                                            <TextBlock Name="LiveDataDescription" Margin="0,4,0,0"
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Name="LiveDataValue" Grid.Column="2" FontSize="22"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TealBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBlock Name="ItemsListTitle" Margin="0,22,0,8" Text="Extrahierte Item-Kandidaten"
                                           FontSize="16" FontWeight="SemiBold" Visibility="Collapsed"/>
                                <TextBlock Name="ItemsListMessage" Margin="0,0,0,10"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <StackPanel Name="ContainerSelectionPanel" Orientation="Horizontal"
                                            Margin="0,0,0,12" Visibility="Collapsed">
                                    <TextBlock Text="Container" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox Name="ContainerComboBox" Width="280" Height="32"
                                              Style="{StaticResource DarkComboBoxStyle}"
                                              SelectionChanged="ContainerSelectionChanged"/>
                                </StackPanel>
                                <StackPanel Name="ItemSearchPanel" Orientation="Horizontal"
                                            Margin="0,0,0,12" Visibility="Collapsed">
                                    <TextBlock Text="Spieldaten durchsuchen" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Name="ItemSearchTextBox" Width="300" Height="32"
                                             Style="{StaticResource DarkTextBoxStyle}"
                                             TextChanged="ItemSearchTextChanged"/>
                                </StackPanel>
                                <Grid Name="InventoryWorkspacePanel" Margin="0,0,0,8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="10" Margin="0,0,12,0"
                                            Background="#0B181A" BorderBrush="#315E5B" BorderThickness="1"
                                            CornerRadius="8">
                                        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      PreviewMouseWheel="InventoryGridPreviewMouseWheel">
                                            <ItemsControl Name="InventoryGrid">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource InventoryTileButtonStyle}"
                                                            Tag="{Binding}" Click="InventorySlotClick">
                                                        <Border Margin="4" Padding="8" MinHeight="92"
                                                                Background="#14292C" BorderBrush="#315E5B"
                                                                BorderThickness="1" CornerRadius="6"
                                                                ToolTip="{Binding Details}">
                                                            <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid>
                                                                <TextBlock Text="{Binding SlotLabel}"
                                                                           Foreground="#91A7A7" FontSize="11"/>
                                                                <Ellipse Width="7" Height="7" Fill="#73D2C0"
                                                                         HorizontalAlignment="Right"
                                                                         Visibility="{Binding IsOccupied, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </Grid>
                                                            <TextBlock Grid.Row="1" Margin="0,8,0,5"
                                                                       Text="{Binding ItemName}" Foreground="#73D2C0"
                                                                       TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Row="2" Text="{Binding Details}"
                                                                       Foreground="#C1EAE2" FontSize="11"
                                                                       TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    <Border Grid.Column="1" Padding="16" Background="#102326"
                                            BorderBrush="#315E5B" BorderThickness="1" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="Instanz-Inspektor" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Name="InventoryInspectorName" Margin="0,18,0,0"
                                                       AutomationProperties.AutomationId="InventoryInspectorName"
                                                       Foreground="{StaticResource TealBrush}" FontSize="18"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Name="InventoryInspectorState" Margin="0,7,0,0"
                                                       AutomationProperties.AutomationId="InventoryInspectorState"
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                            <Border Margin="0,18,0,0" Padding="10" Background="#14292C"
                                                    BorderBrush="#315E5B" BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Text="Aufgeschlüsselte Werte"
                                                               Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                                    <ScrollViewer MaxHeight="330" Margin="0,7,0,0"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <TextBlock Name="InventoryInspectorDetails"
                                                                   AutomationProperties.AutomationId="InventoryInspectorDetails"
                                                                   Foreground="#C1EAE2" TextWrapping="Wrap"/>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Margin="0,18,0,0"
                                                       Text="Die Ansicht verändert keine Savegames."
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Name="EquipmentPanel" Margin="0,0,0,8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="16" Margin="0,0,12,0"
                                            Background="#0B181A" BorderBrush="#315E5B" BorderThickness="1"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Effektive Ausrüstung" FontSize="15"
                                                           FontWeight="SemiBold"/>
                                                <ToggleButton Name="PrestigeEquipmentToggle" Margin="18,0,0,0"
                                                              Content="Prestige anzeigen"
                                                              Style="{StaticResource DarkToggleButtonStyle}"
                                                              Checked="PrestigeEquipmentToggleChanged"
                                                              Unchecked="PrestigeEquipmentToggleChanged"/>
                                            </StackPanel>
                                            <Grid Grid.Row="1" Margin="0,18,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <ItemsControl Name="EquipmentLeftGrid">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Tag="{Binding Item}" Click="EquipmentSlotClick"
                                                                        Margin="4" Padding="10" MinHeight="70"
                                                                        Background="#14292C" BorderBrush="#315E5B"
                                                                        BorderThickness="1" Foreground="#DDF8F1">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding SlotLabel}"
                                                                                   Foreground="{StaticResource MutedBrush}"
                                                                                   FontSize="11"/>
                                                                        <TextBlock Margin="0,6,0,0"
                                                                                   Text="{Binding DisplayName}"
                                                                                   Foreground="{StaticResource TealBrush}"
                                                                                   TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <Border Grid.Column="1" Margin="12,4" CornerRadius="70"
                                                        Background="#102326" BorderBrush="#315E5B"
                                                        BorderThickness="1" MinHeight="260">
                                                    <StackPanel VerticalAlignment="Center"
                                                                HorizontalAlignment="Center">
                                                        <TextBlock Text="CHARAKTER" Foreground="{StaticResource MutedBrush}"
                                                                   HorizontalAlignment="Center" FontSize="11"/>
                                                        <TextBlock Name="EquipmentCharacterName" Margin="0,8,0,0"
                                                                   Text="Liath" Foreground="{StaticResource TealBrush}"
                                                                   FontSize="22" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Liveansicht vorbereitet"
                                                                   Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <ItemsControl Name="EquipmentRightGrid">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Tag="{Binding Item}" Click="EquipmentSlotClick"
                                                                        Margin="4" Padding="10" MinHeight="70"
                                                                        Background="#14292C" BorderBrush="#315E5B"
                                                                        BorderThickness="1" Foreground="#DDF8F1">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding SlotLabel}"
                                                                                   Foreground="{StaticResource MutedBrush}"
                                                                                   FontSize="11"/>
                                                                        <TextBlock Margin="0,6,0,0"
                                                                                   Text="{Binding DisplayName}"
                                                                                   Foreground="{StaticResource TealBrush}"
                                                                                   TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1" Padding="16" Background="#102326"
                                            BorderBrush="#315E5B" BorderThickness="1" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="Ausrüstungsinspektor" FontSize="16"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Name="EquipmentInspectorHint" Margin="0,18,0,0"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="Wähle einen Slot für die vollständige Itemansicht."
                                                       Margin="0,12,0,0" Foreground="#C1EAE2"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <ListBox Name="ItemsListBox" Background="Transparent" BorderThickness="0"
                                         Foreground="#DDF8F1" Visibility="Collapsed" MinHeight="240" MaxHeight="520"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="False"
                                         PreviewMouseWheel="ItemsListPreviewMouseWheel">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#14292C" BorderBrush="#315E5B" BorderThickness="1"
                                                    CornerRadius="7" Padding="12" Margin="0,0,10,10"
                                                    Width="196" Height="142">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="15" FontWeight="SemiBold"
                                                                   Foreground="#73D2C0" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Margin="0,3,0,0" Text="{Binding ResolvedCategory}"
                                                                   Foreground="#C1EAE2" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{Binding ResolvedDetails}"
                                                               Foreground="#C1EAE2" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Row="2" Margin="0,7,0,0" Text="{Binding IdOrReference}"
                                                               FontWeight="SemiBold" Foreground="#DDF8F1"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ResolutionLabel}"
                                                                   Foreground="#91A7A7" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#102023" BorderBrush="#284043" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <TextBlock Name="FooterStatusTextBlock" Text="ShroudStudio bereit" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock HorizontalAlignment="Right" Text="Enshrouded Modding Suite  •  Read-only"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Border Name="LoadingOverlay" Panel.ZIndex="100" Visibility="Collapsed"
                Background="#D9071215">
            <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Name="LoadingTextBlock" Text="Spielstände werden gelesen..."
                           Foreground="#E9FFFA" FontSize="17" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <ProgressBar Margin="0,16,0,0" Height="5" IsIndeterminate="True"
                             Foreground="{StaticResource TealBrush}" Background="#193638"/>
                <TextBlock Margin="0,10,0,0" Text="Die Originaldateien bleiben unverändert."
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
